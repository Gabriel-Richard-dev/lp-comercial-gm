# Backend do formulário de /cadastro. Vazio (ou ausente) = a página segue em modo
# demonstração: valida, mostra o sucesso e não chama ninguém.
#
# É o domínio .convex.site do deployment — httpActions não respondem em .convex.cloud.
VITE_CONVEX_SITE_URL=

# Slug da organização que recebe os cadastros no Convex.
VITE_ORG_SLUG=cpc-geraldo-machado
